;
; Prepare printing
;
G28 ; home all axes
M190 S65 ; Set & wait for bed temp
M109 S245 ; Set & wait for hotend temp
G1 Z10 F3000 ; lift nozzle to clear any raised edges

M190 S65 ; wait for bed temp
M109 S245 ; wait for extruder temp
G92 E0.0
; intro line
G1 Z2.5 F3000 ; Move Z Axis up little to prevent scratching of Heat Bed
G1 X5.0 Y20 Z{layer_height} F5000.0 ; Move to start position
G1 X5.0 Y200.0 Z{layer_height} F1500.0 E15 ; Draw the first line
G1 X5.3 Y200.0 Z{layer_height} F5000.0 ; Move to side a little
G1 X5.3 Y20 Z{layer_height} F1500.0 E30 ; Draw the second line
G92 E0 ; Reset Extruder
G1 E4 F300 ; Retract filiment by 1 mm
G1 Z2.0 F3000 ; Move Z Axis up little to prevent scratching of Heat Bed
G21 ; Millimeter units
G90 ; Absolute XYZ
M83 ; Relative E
G92 E0 ; Reset extruder distance
;
;  Begin printing
;
M106 S0 ; Set fan speed
G1 E-7 F2100 ; Retract
G0 Z5 F7200 ; Z raise
G0 X57.6202 Y73.0068 F7200 ; Move to start position
G0 Z0.2 F7200 ; Move to start layer height
G1 E7 F2100 ; Un-retract
M900 K0 ; Set linear advance k factor to start value
M117 LA 0
